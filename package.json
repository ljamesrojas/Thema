{
  "name": "thema",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "turbo run test",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "extract": "pnpm --filter @thema/worker extract",
    "palette": "tsx scripts/palette.ts",
    "accuracy": "tsx scripts/accuracy.ts",
    "export": "tsx scripts/export.ts",
    "thema": "pnpm --filter @thema/cli --silent thema",
    "mcp": "pnpm --filter @thema/mcp --silent mcp"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@thema/engine": "workspace:*",
    "@thema/exporters": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
