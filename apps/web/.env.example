# Copy to apps/web/.env.local (git-ignored) and fill in. Everything is optional: without these,
# Thema runs fully in the browser (anonymous projects, in-process extraction, no sign-in).

# --- Extraction ---------------------------------------------------------------------------
# Redis for the BullMQ job queue; jobs then run in `pnpm --filter @thema/worker queue`.
# REDIS_URL=redis://localhost:6379
# Production (deploy/README.md): rediss://default:<password>@<vm-ip>:6380, plus the certificate
# authority that signed the VM's Redis certificate, as PEM text (REDIS_TLS_CA; literal \n escapes
# are fine) or a path to it (REDIS_TLS_CA_FILE). Without either, rediss:// trusts the public CAs.
# REDIS_TLS_CA=
# REDIS_TLS_CA_FILE=
# New extractions a signed-out visitor may start per UTC day (default 3).
# THEMA_DAILY_EXTRACTIONS=3

# --- Accounts and saved projects (all of the first three, plus at least one provider) --------
# Postgres (Neon: use the pooled connection string). Then run: pnpm --filter @thema/web db:migrate
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# At least 32 random characters, e.g. `openssl rand -base64 32`. Keep it secret.
# BETTER_AUTH_SECRET=
# The site's public address (callbacks come back here).
# BETTER_AUTH_URL=http://localhost:3000
# GitHub OAuth app: callback URL <BETTER_AUTH_URL>/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Google OAuth client: redirect URI <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Screenshots of saved projects (Cloudflare R2; otherwise kept in memory) -------------
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
