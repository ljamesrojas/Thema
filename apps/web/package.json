    "@thema/url-guard": "workspace:*",
    "@thema/worker": "workspace:*",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.14",
    "bullmq": "6.3.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "culori": "^4.0.2",
    "fflate": "0.8.3",
